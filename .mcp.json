{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "${DATABASE_URL}"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/playwright-mcp"
      ]
    },
    "graft": {
      "command": "npx",
      "args": [
        "-y",
        "@nanonets/graft",
        "mcp"
      ]
    },
    "trm-devops": {
      "command": "node",
      "args": [
        "C:\\dev\\modules\\trm-devops\\dist\\mcp\\server.js"
      ]
    },
    "ironledger": {
      "command": "C:\\dev\\IronLedger\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "ironledger.mcp.stdio",
        "--ledger-dir",
        "C:\\dev\\IronLedger\\ledger",
        "--projection-dir",
        "C:\\dev\\IronLedger\\projection.db",
        "--db",
        "C:\\dev\\IronLedger\\ironledger.db"
      ]
    }
  }
}
