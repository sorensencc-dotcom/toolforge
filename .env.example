# Toolforge Marketplace Environment Template
# Copy to .env (git-ignored) and adjust as needed for your environment.
# This file is NOT committed to version control.

# === Ollama Configuration ===
# Ollama API base URL for local model inference.
# For local Docker development: http://host.docker.internal:11434/v1
# For Kubernetes: http://ollama-service.default.svc.cluster.local:11434/v1
# For remote Ollama: https://your-ollama-host:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Ollama request timeout in milliseconds (optional, default: 30000)
# OLLAMA_TIMEOUT=30000

# === API Configuration ===
PORT=3000
TELEMETRY_API_KEY=replace-with-long-random-value

# === Database Configuration ===
# DATABASE_URL is auto-derived from __dirname in production.
# For local development, optionally set:
# DATABASE_URL=postgresql://user:password@localhost:5432/toolforge

# === Cowork Gateway ===
COWORK_API_URL=http://127.0.0.1:4790
COWORK_API_KEY=mock-api-key-1234567890ab
COWORK_GATEWAY_ID=toolforge-gateway
COWORK_SYNC_INTERVAL=300
TOOLFORGE_SKILLS_PATH=../../skills

# === Logging & Debug ===
# DEBUG=toolforge:*
# LOG_LEVEL=debug
