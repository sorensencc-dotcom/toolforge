{
  "id": "TC-01",
  "title": "Mid-lineage-write fault injection for whichllm extractor",
  "preconditions": [
    "Harvester pipeline active",
    "llmModelSelector.js registered"
  ],
  "steps": [
    "Start ingestion job",
    "Inject fault at lineage write offset +512 bytes",
    "Force extractor to re-run"
  ],
  "expected": [
    "Extractor halts",
    "Lineage lock engages",
    "Rollback to last stable hash",
    "Republish occurs"
  ],
  "lineage_assertions": [
    "hash_chain_self != corrupted_hash",
    "hash_chain_parent preserved"
  ]
}