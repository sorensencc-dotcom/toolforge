{
  "id": "pre-flight-test-checker",
  "name": "Pre-Flight Test Checker",
  "version": "1.0.0",
  "description": "Validates the test environment (ESLint ignore config, external fixtures, platform-specific assumptions) before npm test runs",
  "author": "Soren (Cast Iron Forge)",
  "license": "MIT",
  "category": "validation",
  "runtime": "javascript",
  "entrypoint": "src/index.js",
  "status": "active",
  "keywords": [
    "testing",
    "eslint",
    "fixtures",
    "cross-platform"
  ],
  "commands": {
    "invoke": "pre-flight-test-checker",
    "usage": "node src/index.js [repoRoot] [--verbose] [--failOnWarning]"
  },
  "inputs": {
    "repoRoot": "string (optional, default cwd)",
    "verbose": "boolean (optional) — print full JSON report",
    "failOnWarning": "boolean (optional) — treat YELLOW (warnings) as a failing exit code"
  },
  "outputs": {
    "report": {
      "status": "success|error",
      "verdict": "GREEN|YELLOW|RED",
      "checks": "array<{name, level, message, details?}>",
      "readyToTest": "boolean",
      "timestamp": "ISO 8601"
    }
  },
  "dependencies": {
    "internal": [],
    "external": []
  },
  "errorConditions": [
    {
      "code": "ESLINTIGNORE_MISSING",
      "message": ".eslintignore not found or missing required entries",
      "handler": "fail"
    }
  ],
  "integrations": {
    "cowork": {
      "registered": false,
      "pluginType": "skill",
      "icon": "check-circle",
      "registrationPath": "cowork://toolforge/skills/pre-flight-test-checker",
      "status": "pending_registration"
    }
  },
  "tooltip": "Catches ESLint config gaps, missing fixtures, and platform-specific test assumptions before npm test runs."
}
