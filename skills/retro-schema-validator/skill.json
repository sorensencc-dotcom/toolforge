{
  "id": "retro-schema-validator",
  "name": "Retro Schema Validator",
  "version": "1.0.0",
  "description": "Validates .retro/*.json files against the canonical retro schema v1.0 (required fields, types, ranges, unknown fields)",
  "author": "Soren (Cast Iron Forge)",
  "license": "MIT",
  "category": "validation",
  "runtime": "javascript",
  "entrypoint": "src/index.js",
  "status": "active",
  "keywords": [
    "retro",
    "schema",
    "json-validation"
  ],
  "commands": {
    "invoke": "retro-schema-validator",
    "usage": "node src/index.js [file.json | --all] [--verbose] [--failOnWarning]"
  },
  "inputs": {
    "filePath": "string (optional) — single retro file to validate",
    "all": "boolean (optional) — validate every file under .retro/",
    "verbose": "boolean (optional) — print full JSON report",
    "failOnWarning": "boolean (optional) — treat YELLOW (warnings) as a failing exit code"
  },
  "outputs": {
    "report": {
      "status": "success|error",
      "verdict": "GREEN|YELLOW|RED",
      "filesValidated": "number",
      "violations": "array<{file, field, level, message}>",
      "timestamp": "ISO 8601"
    }
  },
  "dependencies": {
    "internal": [],
    "external": []
  },
  "errorConditions": [
    {
      "code": "RETRO_FILE_INVALID_JSON",
      "message": "Retro file is not valid JSON",
      "handler": "fail"
    }
  ],
  "integrations": {
    "cowork": {
      "registered": false,
      "pluginType": "skill",
      "icon": "clipboard-check",
      "registrationPath": "cowork://toolforge/skills/retro-schema-validator",
      "status": "pending_registration"
    }
  },
  "tooltip": "Validates .retro/*.json against schema v1.0 — required fields, types, ranges, and unknown-field drift."
}
