  "runtime": "node",
  "entrypoint": "src/overview.mjs",
  "keywords": ["overview", "status", "dashboard", "worktrees", "pull-requests", "todos", "receipts", "health"],
  "commands": {
    "run": "node src/overview.mjs",
    "json": "node src/overview.mjs --json",
    "test": "node --test tests/overview.test.mjs"
  },
  "inputs": {
    "workspaceRoot": "string (default: C:\\dev)",
    "json": "boolean (default: false)"
  },
  "outputs": {
    "markdown": "string",
    "data": "object"
  },
  "dependencies": {
    "internal": [],
    "external": []
  },
  "integrations": {
    "cowork": {
      "registered": false,
      "pluginType": "skill",
      "icon": "layout-dashboard",
