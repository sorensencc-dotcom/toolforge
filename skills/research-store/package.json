{
  "name": "research-store-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/mcp-server.mjs",
    "sync": "node src/sync.mjs",
    "test": "node --test --test-timeout=10000 tests/sync.test.mjs tests/mcp.test.mjs tests/package.test.mjs tests/rehearsal.test.mjs tests/config.test.mjs",
    "test:live": "node --test --test-concurrency=1 --test-timeout=100000 tests/schema.test.mjs tests/migration-recovery.test.mjs",
    "test:uat": "node --test --test-timeout=150000 tests/uat.test.mjs",
    "test:jwt-expiry": "node --test --test-timeout=420000 tests/jwt-expiry.test.mjs",
    "test:embedding-quality": "node --test --test-timeout=150000 tests/embedding-quality.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "openai": "^4.60.0",
    "js-yaml": "^4.1.0"
  }
}
