{
  "id": "workspace-storage-cleaner",
  "name": "Workspace & Brain Storage Cleaner",
  "version": "1.0.0",
  "description": "Audits, detects, and safely purges stale artifacts, orphaned nested git clones in brain sessions, oversized execution logs, and stray temporary files across Antigravity Brain and development workspaces.",
  "category": "maintenance",
  "runtime": "python",
  "entrypoint": "scripts/clean-storage.py",
  "keywords": ["storage", "cleaner", "brain", "disk", "maintenance", "logs"],
  "commands": {
    "audit": "python scripts/clean-storage.py",
    "clean": "python scripts/clean-storage.py --apply"
  },
  "inputs": {
    "brainRoot": "string (default: ~/.gemini/antigravity/brain)",
    "workspaceRoot": "string (default: C:\\dev)",
    "apply": "boolean (default: false)"
  },
  "outputs": {
    "reclaimedBytes": "number",
    "actions": "array of cleaned items"
  },
  "dependencies": {
    "internal": [],
    "external": ["python3"]
  },
  "integrations": {
    "cowork": {
      "registered": false,
      "pluginType": "skill",
      "icon": "trash-2",
      "registrationPath": "cowork://toolforge/skills/workspace-storage-cleaner",
      "status": "pending_registration"
    }
  },
  "tooltip": "Safely reclaims disk space by purging nested .git clones, oversized logs, and temporary workspace artifacts."
}
