{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cic:retro-inbox:v1",
  "title": "Retro inbox entry",
  "description": "One retro inbox entry (retro-inbox/1), specified in .context/retros/INBOX-SPEC.md. Generated from INBOX_REGISTRY by `node scripts/validate-retro-inbox.mjs --write-schema`. Do not edit by hand.",
  "type": "object",
  "required": [
    "schema",
    "agent",
    "repo",
    "date",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "retro-inbox/1"
    },
    "agent": {
      "enum": [
        "claude",
        "codex",
        "grok",
        "gemini",
        "copilot",
        "antigravity",
        "human",
        "ci"
      ]
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "session": {
      "type": "string",
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tag",
          "severity",
          "summary",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RF-[0-9a-f]{12}$"
          },
          "tag": {
            "enum": [
              "INGESTION",
              "MCP",
              "GATE",
              "CI",
              "DRIFT",
              "SPEC",
              "TEST",
              "PROCESS",
              "TOOLING",
              "SECURITY"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "pattern": "^[^\\S\\r\\n]*\\S[^\\r\\n]*$",
            "maxLength": 200
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "suggestion": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
