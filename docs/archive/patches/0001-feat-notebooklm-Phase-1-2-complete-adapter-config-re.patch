+# cic_notebooks.yaml
+# NotebookLM Namespace Registry — CIC Integration
+#
+# Governance:
+#   - Modifications require PR + Architecture Lead approval (Chris)
+#   - All IDs must match UUID v4 pattern: [a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}
+#   - Rotation required every 90 days (cron verifies activity)
+#   - Agent roles have READ-ONLY access to this file
+#   - Hot-reload supported via fs.watch/watchdog; failed reloads retain previous valid config
+#
+# Authuser index: 2 (all notebooks belong to authuser=2 Google account)
+#
+authuser_index: 2
+
+notebook_mappings:
+  # ── CIC / Client Knowledge Vaults ────────────────────────────────────────────
+  cic_client_vault_1:     "1b4861a3-931f-4632-8fc1-343a8dd37df8"
+  cic_client_vault_2:     "a574fa62-68f5-4cd7-8589-57d35f04268a"
+  cic_client_vault_3:     "bec5a197-8256-4eba-af78-c4881cc28fdd"
+  cic_client_vault_4:     "3d1f84b2-1ac8-48d2-8ec8-5052e91a55a0"
+  cic_client_vault_5:     "ef78168d-b7b9-4952-8e0f-fcb353a21181"
+
+  # ── Isolated / Personal Research ─────────────────────────────────────────────
+  bourbon_tracker:         "482b69ee-6796-4990-bc9b-4425b11becd1"
+
+# ── Rotation Schedule ─────────────────────────────────────────────────────────
+# Next verification due: 2026-10-07
+# Rotation owner: CIC Infrastructure Lead
+rotation_interval_days: 90
+last_verified: "2026-07-08"
