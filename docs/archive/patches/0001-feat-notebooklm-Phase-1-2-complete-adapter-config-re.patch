+/**
+ * NotebookLMAdapter.ts
+ *
+ * CIC adapter for Google NotebookLM.
+ * Extends BaseAdapter — same contract as FamilySearchAdapter.
+ *
+ * Architecture:
+ *   - Browser automation is delegated to the NotebookLM skill scripts
+ *     (claude-skills/integrations/antigravity/notebooklm/scripts/)
+ *   - This adapter handles: namespace resolution, rate-limiting, timeout
+ *     cascade, schema validation, and error normalization
+ *   - NO direct HTTP calls to NotebookLM — all interaction goes through
+ *     the skill's action_router.py which drives browser automation
+ *
+ * Rate limits (per integration plan §10.1):
+ *   - 10 req/min per authuser index
+ *   - 100 req/day per authuser index
+ *   - FIFO queue depth: 10 (excess → NotebookLMRateLimitError)
+ *
+ * Timeout cascade (§10.2):
+ *   - 15s socket timeout → drop federated leg, return local results
+ *     with metadata flag: { notebooklm_partial_results: true, notebooklm_error_code: "TIMEOUT" }
+ */
+
+import { spawn } from "child_process";
+import { readFileSync } from "fs";
+import * as path from "path";
+import { BaseAdapter, AdapterConfig, AdapterInput, AdapterOutput } from "./BaseAdapter";
+
+// ── Types ──────────────────────────────────────────────────────────────────────
+
+export interface NotebookLMAdapterConfig extends AdapterConfig {
+  /** Absolute path to cic_notebooks.yaml */
+  notebooksConfigPath: string;
+  /** Absolute path to the skill scripts directory */
+  skillScriptsPath: string;
+  /** Google account authuser index */
+  authuserIndex: number;
+  /** Max requests per minute (default: 10) */
+  rateLimitRpm: number;
+  /** Max requests per day (default: 100) */
+  rateLimitRpd: number;
+  /** Query timeout in milliseconds (default: 15000) */
+  queryTimeoutMs: number;
+}
+
+export interface NotebookLMQuery {
+  /** Logical namespace key from cic_notebooks.yaml (e.g. "cic_client_vault_1") */
+  namespace: string;
+  /** Natural-language question to send to the notebook chat */
+  question: string;
+}
+
+export interface NotebookLMResult {
+  namespace: string;
+  notebookId: string;
+  answer: string;
+  latencyMs: number;
+  authuserIndex: number;
+}
+
+export interface NotebookLMAdapterOutput extends AdapterOutput {
+  notebookResult?: NotebookLMResult;
+  /** Set true when timeout cascade fires and federated leg is dropped */
+  notebooklm_partial_results?: boolean;
+  notebooklm_error_code?: "TIMEOUT" | "RATE_LIMIT" | "AUTH_ERROR" | "NAMESPACE_NOT_FOUND" | "SCRIPT_ERROR";
+}
+
+// ── Errors ─────────────────────────────────────────────────────────────────────
+
+export class NotebookLMRateLimitError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "NotebookLMRateLimitError";
+  }
+}
+
+export class NotebookLMAuthError extends Error {
+  /** JSON-RPC error code per MCP architecture spec §3.2 */
+  readonly code = -32001;
+  constructor(message: string) {
+    super(message);
+    this.name = "NotebookLMAuthError";
+  }
+}
+
+export class NotebookLMNamespaceError extends Error {
+  constructor(namespace: string) {
+    super(`Namespace '${namespace}' not found in cic_notebooks.yaml`);
+    this.name = "NotebookLMNamespaceError";
+  }
+}
+
+export class NotebookLMTimeoutError extends Error {
+  constructor(timeoutMs: number) {
+    super(`NotebookLM query exceeded timeout budget of ${timeoutMs}ms`);
+    this.name = "NotebookLMTimeoutError";
+  }
+}
+
+// ── Namespace loader ───────────────────────────────────────────────────────────
+
+interface NotebooksConfig {
+  authuser_index: number;
+  notebook_mappings: Record<string, string>;
+}
+
+function loadNotebooksConfig(configPath: string): NotebooksConfig {
+  const raw = readFileSync(configPath, "utf8");
+  // Minimal YAML parser for our specific schema (no nested objects beyond mappings)
+  const lines = raw.split("\n");
+  const config: NotebooksConfig = { authuser_index: 2, notebook_mappings: {} };
+  let inMappings = false;
+
+  for (const line of lines) {
+    const trimmed = line.trim();
+    if (!trimmed || trimmed.startsWith("#")) continue;
+
+    if (trimmed === "notebook_mappings:") { inMappings = true; continue; }
+    if (inMappings && trimmed.startsWith("authuser_index:")) { inMappings = false; }
+    if (!inMappings && trimmed.startsWith("authuser_index:")) {
+      config.authuser_index = parseInt(trimmed.split(":")[1].trim(), 10);
+      continue;
+    }
+    if (inMappings && line.startsWith(" ") && trimmed.includes(":")) {
+      const colonIdx = trimmed.indexOf(":");
+      const key = trimmed.slice(0, colonIdx).trim();
+      const value = trimmed.slice(colonIdx + 1).trim().replace(/"/g, "");
+      if (key && value) config.notebook_mappings[key] = value;
+    }
+    // Exit mappings block on next top-level key
+    if (inMappings && !line.startsWith(" ") && trimmed.includes(":") && !trimmed.startsWith("notebook_mappings")) {
+      inMappings = false;
+    }
+  }
+  return config;
+}
+
+// ── Rate limiter ───────────────────────────────────────────────────────────────
+
+class RateLimiter {
+  private minuteWindow: number[] = [];
+  private dayWindow: number[] = [];
+
+  constructor(
+    private readonly rpm: number,
+    private readonly rpd: number
+  ) {}
+
+  /** @throws {NotebookLMRateLimitError} when limit exceeded */
+  check(): void {
+    const now = Date.now();
+    // Purge stale entries
+    this.minuteWindow = this.minuteWindow.filter(t => now - t < 60_000);
+    this.dayWindow = this.dayWindow.filter(t => now - t < 86_400_000);
+
+    if (this.minuteWindow.length >= this.rpm) {
+      throw new NotebookLMRateLimitError(
+        `Rate limit: ${this.rpm} req/min exceeded. Retry after ${Math.ceil((60_000 - (now - this.minuteWindow[0])) / 1000)}s`
+      );
+    }
+    if (this.dayWindow.length >= this.rpd) {
+      throw new NotebookLMRateLimitError(
+        `Rate limit: ${this.rpd} req/day exceeded. Daily quota exhausted.`
+      );
+    }
+
+    this.minuteWindow.push(now);
+    this.dayWindow.push(now);
+  }
+}
+
+// ── Script runner ──────────────────────────────────────────────────────────────
+
+function runActionRouter(
+  scriptPath: string,
+  args: string[],
+  timeoutMs: number
+): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const proc = spawn("python", [scriptPath, ...args, "--output", "json"]);
+    let stdout = "";
+    let stderr = "";
+
+    const timer = setTimeout(() => {
+      proc.kill();
+      reject(new NotebookLMTimeoutError(timeoutMs));
+    }, timeoutMs);
+
+    proc.stdout.on("data", (chunk: Buffer) => { stdout += chunk.toString(); });
+    proc.stderr.on("data", (chunk: Buffer) => { stderr += chunk.toString(); });
+
+    proc.on("close", (code: number | null) => {
+      clearTimeout(timer);
+      if (code === 0) {
+        resolve(stdout);
+      } else {
+        reject(new Error(`action_router.py exited ${code}: ${stderr.trim()}`));
+      }
+    });
+  });
+}
+
+// ── Adapter ────────────────────────────────────────────────────────────────────
+
+export class NotebookLMAdapter extends BaseAdapter {
+  private readonly notebooksConfig: NotebooksConfig;
+  private readonly rateLimiter: RateLimiter;
+  private readonly skillScriptsPath: string;
+  private readonly queryTimeoutMs: number;
+
+  constructor(config: NotebookLMAdapterConfig) {
+    super(config);
+    this.notebooksConfig = loadNotebooksConfig(config.notebooksConfigPath);
+    this.rateLimiter = new RateLimiter(config.rateLimitRpm, config.rateLimitRpd);
+    this.skillScriptsPath = config.skillScriptsPath;
+    this.queryTimeoutMs = config.queryTimeoutMs;
+  }
+
+  // ── BaseAdapter contract ────────────────────────────────────────────────────
+
+  normalize(input: NotebookLMQuery): AdapterInput {
+    return {
+      key: `notebooklm::${input.namespace}`,
+      payload: {
+        namespace: input.namespace,
+        question: input.question,
+      },
+    };
+  }
+
+  async run(input: AdapterInput): Promise<NotebookLMAdapterOutput> {
+    const { namespace, question } = input.payload as NotebookLMQuery;
+    const startMs = Date.now();
+
+    // 1. Resolve namespace → notebookId
+    const notebookId = this.notebooksConfig.notebook_mappings[namespace];
+    if (!notebookId) {
+      return this.partialResult(
+        new NotebookLMNamespaceError(namespace),
+        "NAMESPACE_NOT_FOUND",
+        startMs
+      );
+    }
+
+    // 2. Rate-limit check
+    try {
+      this.rateLimiter.check();
+    } catch (err) {
+      if (err instanceof NotebookLMRateLimitError) {
+        return this.partialResult(err, "RATE_LIMIT", startMs);
+      }
+      throw err;
+    }
+
+    // 3. Build NotebookLM URL from ID + authuser index
+    const notebookUrl = `https://notebooklm.google.com/notebook/${notebookId}?authuser=${this.notebooksConfig.authuser_index}`;
+
+    // 4. Invoke action_router.py with read_extract action
+    const actionRouterPath = path.join(this.skillScriptsPath, "action_router.py");
+    const args = [
+      "--action", "read_extract",
+      "--notebook", notebookUrl,
+      "--question", question,
+    ];
+
+    let routerOutput: string;
+    try {
+      routerOutput = await runActionRouter(actionRouterPath, args, this.queryTimeoutMs);
+    } catch (err) {
+      if (err instanceof NotebookLMTimeoutError) {
+        return this.partialResult(err, "TIMEOUT", startMs);
+      }
+      return this.partialResult(err as Error, "SCRIPT_ERROR", startMs);
+    }
+
+    // 5. Parse and return
+    const latencyMs = Date.now() - startMs;
+    let parsed: any;
+    try {
+      parsed = JSON.parse(routerOutput);
+    } catch {
+      return this.partialResult(
+        new Error(`Failed to parse action_router output: ${routerOutput.slice(0, 200)}`),
+        "SCRIPT_ERROR",
+        startMs
+      );
+    }
+
+    const result: NotebookLMResult = {
+      namespace,
+      notebookId,
+      answer: parsed?.parameters?.question ?? "(no answer extracted)",
+      latencyMs,
+      authuserIndex: this.notebooksConfig.authuser_index,
+    };
+
+    return {
+      success: true,
+      timestamp: Date.now(),
+      notebookResult: result,
+      hydration: {
+        cached: false,
+        timestamp: Date.now(),
+      },
+    };
+  }
+
+  validate(output: NotebookLMAdapterOutput): NotebookLMAdapterOutput {
+    // Schema contract: success=true requires notebookResult with required fields
+    if (output.success && output.notebookResult) {
+      const r = output.notebookResult;
+      if (!r.namespace || !r.notebookId || !r.answer) {
+        return {
+          ...output,
+          success: false,
+          error: "Schema validation failed: notebookResult missing required fields (namespace, notebookId, answer)",
+        };
+      }
+      // UUID format check
+      const uuidPattern = /^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/;
+      if (!uuidPattern.test(r.notebookId)) {
+        return {
+          ...output,
+          success: false,
+          error: `Schema validation failed: notebookId '${r.notebookId}' does not match UUID v4 pattern`,
+        };
+      }
+    }
+    return output;
+  }
+
+  // ── Private helpers ─────────────────────────────────────────────────────────
+
+  /**
+   * Timeout cascade: drop federated leg, return partial result.
+   * Callers receive local results + partial flag per integration plan §10.2.
+   */
+  private partialResult(
+    err: Error,
+    errorCode: NotebookLMAdapterOutput["notebooklm_error_code"],
+    startMs: number
+  ): NotebookLMAdapterOutput {
+    return {
+      success: false,
+      error: err.message,
+      timestamp: Date.now(),
+      notebooklm_partial_results: true,
+      notebooklm_error_code: errorCode,
+      hydration: {
+        cached: false,
+        timestamp: Date.now(),
+        errors: [err.message],
+      },
+    };
+  }
+}
