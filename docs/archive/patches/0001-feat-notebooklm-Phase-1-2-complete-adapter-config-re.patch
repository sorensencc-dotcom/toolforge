+/**
+ * createNotebookLMAdapter.ts
+ *
+ * Factory that constructs a NotebookLMAdapter from environment / config.
+ * Used by bootstrap, integration tests, and the CIC ingestion server.
+ *
+ * Config resolution order:
+ *   1. Explicit `config` argument (highest priority)
+ *   2. Environment variables (NOTEBOOKLM_*)
+ *   3. Hardcoded defaults (lowest priority)
+ */
+
+import * as path from "path";
+import { NotebookLMAdapter, NotebookLMAdapterConfig } from "./NotebookLMAdapter";
+
+const DEFAULT_NOTEBOOKS_CONFIG = path.resolve(
+  __dirname,
+  "../../config/cic_notebooks.yaml"
+);
+
+const DEFAULT_SKILL_SCRIPTS = path.resolve(
+  "C:/dev/claude-skills/integrations/antigravity/notebooklm/scripts"
+);
+
+export function createNotebookLMAdapter(
+  config?: Partial<NotebookLMAdapterConfig>
+): NotebookLMAdapter {
+  const resolved: NotebookLMAdapterConfig = {
+    name: "notebooklm",
+    version: "1.0.0",
+    timeout: parseInt(process.env.NOTEBOOKLM_TIMEOUT_MS ?? "15000", 10),
+    retries: parseInt(process.env.NOTEBOOKLM_RETRIES ?? "1", 10),
+    notebooksConfigPath:
+      process.env.NOTEBOOKLM_NOTEBOOKS_CONFIG ?? DEFAULT_NOTEBOOKS_CONFIG,
+    skillScriptsPath:
+      process.env.NOTEBOOKLM_SKILL_SCRIPTS_PATH ?? DEFAULT_SKILL_SCRIPTS,
+    authuserIndex: parseInt(process.env.NOTEBOOKLM_AUTHUSER_INDEX ?? "2", 10),
+    rateLimitRpm: parseInt(process.env.NOTEBOOKLM_RATE_LIMIT_RPM ?? "10", 10),
+    rateLimitRpd: parseInt(process.env.NOTEBOOKLM_RATE_LIMIT_RPD ?? "100", 10),
+    queryTimeoutMs: parseInt(process.env.NOTEBOOKLM_QUERY_TIMEOUT_MS ?? "15000", 10),
+    ...config,
+  };
+
+  return new NotebookLMAdapter(resolved);
+}
